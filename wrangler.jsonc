{
  "name": "cocoa-and-credits",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cocoa-and-credits",
      "database_id": "f0fb6a3b-372f-47eb-9a9d-97f448a77819"
    }
  ]
}
